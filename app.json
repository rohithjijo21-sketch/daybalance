{
  "expo": {
    "name": "DayBalance",
    "slug": "daybalance",
    "version": "1.2.1",
    "icon": "./assets/brand/icon.png",
    "scheme": "daybalance",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.daybalance.app"
    },
    "android": {
      "package": "com.daybalance.app",
      "versionCode": 5,
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-foreground.png",
        "monochromeImage": "./assets/brand/adaptive-monochrome.png",
        "backgroundColor": "#95532F"
      }
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-notifications",
      "expo-document-picker"
    ],
    "web": {
      "bundler": "metro",
      "favicon": "./assets/brand/favicon.png"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "92861572-10ab-4ba5-b277-1d19bfda0c54"
      }
    }
  }
}
